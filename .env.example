# The backend loads the repository-root .env at startup; exported variables take precedence.
# Keep real credentials in your environment or the ignored local .env file.
GROQ_API_KEY=

# Explicit Kubernetes identity; never falls back to personal KUBECONFIG settings.
AIOPS_KUBERNETES_MODE=kubeconfig
# Absolute path generated by scripts/create_agent_kubeconfig.py (never commit it).
AIOPS_KUBECONFIG_PATH=
# Future Pods can explicitly use AIOPS_KUBERNETES_MODE=incluster instead.

# Required: generate with `uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
# Store privately in .env or inject via a secret manager. Never commit the value.
AIOPS_JWT_SECRET=
AIOPS_JWT_ISSUER=aiops-backend
AIOPS_JWT_AUDIENCE=aiops-api
AIOPS_ACCESS_TOKEN_MINUTES=60
AIOPS_DATABASE_URL=sqlite:///./aiops.db
s
# Optional: private investigation logs (default: repository-root logs/backend).
# Use a separate directory per server process; keep custom paths outside Git.
# AIOPS_LOG_DIR=logs/backend

# Optional: additional sensitive literals to redact from persisted logs.
# Multiple values can be supplied as a newline-separated environment variable.
AIOPS_LOG_REDACT_VALUES=
