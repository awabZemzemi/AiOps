# The backend loads the repository-root .env at startup; exported variables take precedence.
# Keep real credentials in your environment or the ignored local .env file.
GROQ_API_KEY=

# Optional: private investigation logs (default: repository-root logs/backend).
# Use a separate directory per server process; keep custom paths outside Git.
# AIOPS_LOG_DIR=logs/backend

# Optional: additional sensitive literals to redact from persisted logs.
# Multiple values can be supplied as a newline-separated environment variable.
AIOPS_LOG_REDACT_VALUES=
